<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ares_erc_bringup</name>
  <version>0.0.1</version>
  <description>
    ERC (European Rover Challenge) GPS-free autonomy bring-up for the ARES rover.
    Phase 0: Livox Mid-360 + FAST-LIO2 mapping to a saved .pcd point-cloud map.
    Holds ERC-specific launch/config; the FAST-LIO2 backbone (package: fast_lio)
    and the Livox driver (livox_ros_driver2) are used unmodified.
  </description>
  <maintainer email="setomitsumasa@gmail.com">setomitsumasa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Packages this bring-up launches at runtime -->
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Phase 1a: datum/waypoint node + prior-map display -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>pcl_ros</exec_depend>

  <!-- Phase 1b: map_anchor C++ relocalization node -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>

  <!-- downsample_map: field-use prior-map promotion tool (params in config, not argv) -->
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>

  <!-- Phase 2 (2a): global odometry node -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Phase 3: ArUco map->datum anchor (reuses shared aruco_opencv + realsense_from_lib) -->
  <exec_depend>aruco_opencv_msgs</exec_depend>
  <exec_depend>aruco_opencv</exec_depend>
  <exec_depend>realsense_from_lib</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
