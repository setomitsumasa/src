Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: PriorMap
      Enabled: true
      Topic:
        Value: /erc/prior_map
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 130; 130; 130
      Decay Time: 0
      Position Transformer: XYZ
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiveCloud
      Enabled: true
      Topic:
        Value: /cloud_registered
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
      Position Transformer: XYZ
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /erc/odometry
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Keep: 1
      Shape: Arrow
      Color: 255; 220; 0
      Shaft Length: 0.6
      Shaft Radius: 0.06
      Head Length: 0.25
      Head Radius: 0.12
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Topic:
        Value: /erc/trajectory
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Line Style: Lines
      Color: 0; 200; 255
    - Class: rviz_default_plugins/MarkerArray
      Name: Waypoints
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /erc/waypoint_markers
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 15
      Pitch: 0.6
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
