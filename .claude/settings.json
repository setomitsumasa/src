{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Bash(git push upstream*)",
      "Bash(git push -u upstream*)",
      "Bash(git push --set-upstream upstream*)",
      "Bash(git push -f upstream*)",
      "Bash(git push --force upstream*)",
      "Bash(git push --force-with-lease upstream*)",
      "Bash(git push urc2026*)",
      "Bash(git push -u urc2026*)",
      "Bash(git push --set-upstream urc2026*)",
      "Bash(git push -f urc2026*)",
      "Bash(git push --force urc2026*)",
      "Bash(git push --force-with-lease urc2026*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push origin --force*)",
      "Bash(git push origin -f*)",
      "Bash(git push origin --force-with-lease*)"
    ]
  }
}
